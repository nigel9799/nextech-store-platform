{
  "name": "nextech-store-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:unit && npm run test:migrations",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:migrations": "node scripts/check-migrations.mjs",
    "test:secrets": "node scripts/check-client-secrets.mjs",
    "test:db": "supabase test db",
    "test:e2e": "playwright test",
    "test:e2e:auth": "node scripts/setup-local-auth.mjs && playwright test --config playwright.auth.config.ts",
    "auth:local:setup": "node scripts/setup-local-auth.mjs",
    "storefront:local:seed": "node scripts/seed-local-storefront.mjs",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run test:secrets && npm run build",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.112.2",
    "geist": "1.7.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "server-only": "0.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.2.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.6",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "supabase": "2.113.0",
    "tailwindcss": "4.2.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
